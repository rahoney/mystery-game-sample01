{
  "name": "trace-the-last-visitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:case": "node --import tsx scripts/validate-case.ts",
    "assets:pixellab": "node --import tsx scripts/generate-pixellab-assets.ts",
    "assets:check": "node --import tsx scripts/check-assets.ts",
    "check": "npm run validate:case && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
